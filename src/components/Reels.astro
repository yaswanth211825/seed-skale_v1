---
// Drawn illustration for the content service: three reel cards.
---

<div class="reels" aria-hidden="true">
  {[0, 1, 2].map((n) => (
    <div class:list={['reel', `r${n}`]}>
      <span class="play"></span>
      <span class="bar"></span><span class="bar short"></span>
    </div>
  ))}
</div>

<style>
  .reels { display: flex; justify-content: center; gap: 4%; width: 100%; height: 100%; min-height: 220px; padding: 7% 9%; background: radial-gradient(circle at 25% 15%, rgb(255 107 74 / 22%), transparent 55%), radial-gradient(circle at 85% 90%, rgb(255 176 32 / 30%), transparent 50%), var(--cream-2); }
  .reel { position: relative; flex: 1; display: grid; align-content: end; gap: 6px; padding: 10% 9%; border-radius: 18px; background: linear-gradient(180deg, #2a4a78, #13294a); box-shadow: 0 16px 30px rgb(11 31 58 / 25%); }
  .reel.r1 { translate: 0 -8%; background: linear-gradient(180deg, #ff8a5c, #c4443a); }
  .reel.r2 { background: linear-gradient(180deg, #ffc857, #d9852a); }
  .play { position: absolute; top: 50%; left: 50%; translate: -50% -50%; width: 30%; aspect-ratio: 1; border-radius: 50%; background: rgb(255 255 255 / 88%); }
  .play::after { content: ''; position: absolute; top: 50%; left: 55%; translate: -50% -50%; border-left: 12px solid var(--navy); border-top: 8px solid transparent; border-bottom: 8px solid transparent; }
  .bar { height: 6px; border-radius: 6px; background: rgb(255 255 255 / 70%); }
  .bar.short { width: 60%; }
</style>
