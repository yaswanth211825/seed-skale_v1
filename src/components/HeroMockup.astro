---
// A hand-built mockup of a client site on a phone, with live-feeling notifications.
---

<div class="mockup" data-tilt data-loop aria-hidden="true">
  <div class="phone">
    <div class="phone-top"><span class="dot"></span><span class="bar"></span></div>
    <div class="screen">
      <div class="site-head">
        <span class="site-logo"></span>
        <span class="site-name">Sample Biryani House</span>
      </div>
      <div class="site-hero">
        <span class="steam s1"></span><span class="steam s2"></span><span class="steam s3"></span>
        <span class="pot"></span>
      </div>
      <p class="site-title">Hyderabadi dum biryani</p>
      <p class="site-meta">Open daily · Kukatpally · ★ 4.8</p>
      <span class="site-btn">Order on WhatsApp</span>
      <div class="site-rows"><span></span><span></span><span></span></div>
    </div>
  </div>

  <div class="note note-enquiry" data-parallax="0.25">
    <span class="note-icon wa"></span>
    <span><strong>New enquiry</strong><small>via WhatsApp · just now</small></span>
  </div>
  <div class="note note-google" data-parallax="0.15">
    <span class="note-icon g">G</span>
    <span><strong>Found on Google</strong><small>“biryani near me”</small></span>
  </div>
  <div class="note note-chart" data-parallax="0.3">
    <small>Calls this week</small>
    <div class="bars"><i style="--h:30%"></i><i style="--h:45%"></i><i style="--h:40%"></i><i style="--h:62%"></i><i style="--h:58%"></i><i style="--h:80%"></i><i style="--h:96%"></i></div>
  </div>
</div>

<style>
  .mockup {
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    max-width: 560px;
    aspect-ratio: 1 / .95;
    margin-inline: auto;
    perspective: 1200px;
  }
  .mockup::before {
    content: '';
    position: absolute;
    inset: 4% 8%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 176 32 / 38%), rgb(255 176 32 / 8%) 50%, transparent 70%);
    filter: blur(8px);
  }

  .phone {
    position: relative;
    width: min(54%, 280px);
    aspect-ratio: 9 / 17.5;
    padding: 10px;
    border-radius: 36px;
    background: linear-gradient(160deg, #1f3d66, #0b1f3a);
    box-shadow: 0 40px 80px rgb(11 31 58 / 35%), inset 0 0 0 1.5px rgb(255 255 255 / 12%);
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform .5s var(--ease-out);
    animation: float 7s ease-in-out infinite;
  }
  .phone-top { display: flex; justify-content: center; align-items: center; gap: 8px; height: 18px; }
  .phone-top .dot { width: 6px; height: 6px; border-radius: 50%; background: rgb(255 255 255 / 25%); }
  .phone-top .bar { width: 46px; height: 5px; border-radius: 5px; background: rgb(255 255 255 / 18%); }

  .screen {
    display: grid;
    align-content: start;
    gap: 10px;
    height: calc(100% - 18px);
    padding: 14px;
    border-radius: 26px;
    background: var(--white);
    color: var(--navy);
    overflow: hidden;
  }
  .site-head { display: flex; align-items: center; gap: 8px; }
  .site-logo { width: 18px; height: 18px; border-radius: 6px; background: var(--saffron); }
  .site-name { font: 700 .72rem var(--font-display); }
  .site-hero {
    position: relative;
    aspect-ratio: 16 / 11;
    border-radius: 16px;
    background: linear-gradient(135deg, #ffe2a8, #ffb020 60%, #ff8a3d);
    overflow: hidden;
  }
  .pot {
    position: absolute;
    left: 50%;
    bottom: 14%;
    width: 46%;
    height: 34%;
    translate: -50% 0;
    border-radius: 6px 6px 40% 40%;
    background: #7a3b12;
    box-shadow: inset 0 6px 0 rgb(255 255 255 / 15%);
  }
  .steam {
    position: absolute;
    bottom: 46%;
    width: 8px;
    height: 26%;
    border-radius: 8px;
    background: rgb(255 255 255 / 70%);
    filter: blur(2px);
    animation: steam 3.2s ease-in-out infinite;
  }
  .s1 { left: 38%; }
  .s2 { left: 49%; animation-delay: -1s; }
  .s3 { left: 60%; animation-delay: -2s; }
  .site-title { font: 800 .95rem/1.2 var(--font-display); letter-spacing: -.02em; }
  .site-meta { font-size: .68rem; color: #4a5b6e; }
  .site-btn {
    justify-self: start;
    padding: 8px 12px;
    border-radius: 999px;
    background: var(--saffron);
    font: 700 .7rem var(--font-display);
    animation: pulse 2.8s ease-in-out infinite;
  }
  .site-rows { display: grid; gap: 7px; margin-top: 4px; }
  .site-rows span { height: 8px; border-radius: 6px; background: #efe8d6; }
  .site-rows span:nth-child(2) { width: 82%; }
  .site-rows span:nth-child(3) { width: 64%; }

  .note {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border: 1px solid rgb(11 31 58 / 8%);
    border-radius: 18px;
    background: var(--paper);
    color: var(--navy);
    box-shadow: 0 18px 40px rgb(11 31 58 / 16%);
    font-size: .8rem;
    animation: float 6s ease-in-out infinite;
  }
  .note strong { display: block; font: 700 .82rem var(--font-display); }
  .note small { color: #56606e; font-size: .72rem; }
  .note-icon { display: grid; place-items: center; flex: none; width: 30px; height: 30px; border-radius: 50%; font: 800 .85rem var(--font-display); }
  .note-icon.wa { background: #25d366; }
  .note-icon.wa::after { content: ''; width: 12px; height: 12px; border-radius: 50% 50% 50% 0; background: var(--white); }
  .note-icon.g { background: #eef2ff; color: var(--blue); }

  .note-enquiry { top: 18%; right: 0; animation-delay: -2s; }
  .note-google { bottom: 12%; left: 0; animation-delay: -4s; }
  .note-chart { top: 6%; left: 4%; display: grid; gap: 6px; width: 132px; animation-delay: -1s; }
  .bars { display: flex; align-items: end; gap: 4px; height: 38px; }
  .bars i { flex: 1; height: var(--h); border-radius: 3px; background: var(--navy); transform-origin: bottom; animation: grow 1.2s var(--ease-out) both; }
  .bars i:last-child { background: var(--saffron); }
  .bars i:nth-child(2) { animation-delay: .08s; } .bars i:nth-child(3) { animation-delay: .16s; }
  .bars i:nth-child(4) { animation-delay: .24s; } .bars i:nth-child(5) { animation-delay: .32s; }
  .bars i:nth-child(6) { animation-delay: .4s; } .bars i:nth-child(7) { animation-delay: .48s; }

  @keyframes float { 50% { translate: 0 -10px; } }
  @keyframes steam { 0% { opacity: 0; transform: translateY(10px) scaleY(.6); } 40% { opacity: .9; } 100% { opacity: 0; transform: translateY(-18px) scaleY(1.1); } }
  @keyframes pulse { 50% { box-shadow: 0 0 0 6px rgb(255 176 32 / 25%); } }
  @keyframes grow { from { transform: scaleY(0); } }

  @media (max-width: 480px) {
    .note { padding: 8px 10px; }
    .note-chart { width: 112px; }
    .note-enquiry { right: -2%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .phone, .note, .steam, .site-btn, .bars i { animation: none; }
    .phone { transition: none; }
  }
</style>

<script>
  // Gentle tilt toward the cursor on desktop.
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const el = document.querySelector<HTMLElement>('[data-tilt]');
  if (el && fine && !still) {
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      el.style.setProperty('--ry', `${x * 14}deg`);
      el.style.setProperty('--rx', `${-y * 10}deg`);
    });
    el.addEventListener('pointerleave', () => {
      el.style.setProperty('--ry', '0deg');
      el.style.setProperty('--rx', '0deg');
    });
  }
</script>
