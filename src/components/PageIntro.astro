---
// Inner-page hero, matching the home hero: label, headline with a scribbled accent,
// lede, optional actions (default slot), an optional drawn scene on the right
// (slot="scene") and an optional keyword ticker underneath.
interface Props {
  label: string;
  title: string;
  /** Words at the end of the headline set in the italic accent, with a drawn underline. */
  accent?: string;
  lede?: string;
  ticker?: string[];
  /** Hide the scene on phones, e.g. when a form below matters more. */
  sceneDesktopOnly?: boolean;
}
const { label, title, accent, lede, ticker, sceneDesktopOnly } = Astro.props;
const hasScene = Astro.slots.has('scene');
---

<section class:list={['page-intro', { 'has-ticker': ticker?.length }]}>
  <div class:list={['container', 'intro-grid', { 'with-scene': hasScene }]}>
    <div class="intro-copy">
      <p class="label">{label}</p>
      <h1 data-no-split>
        {title}
        {accent && (
          <>
            {' '}
            <em class="accent">{accent}<svg class="scribble" viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true"><path d="M4 16 C 60 6, 140 4, 296 12" /></svg></em>
          </>
        )}
      </h1>
      {lede && <p class="lede">{lede}</p>}
      <slot />
    </div>
    {hasScene && <div class:list={['intro-scene', { 'desktop-only': sceneDesktopOnly }]} aria-hidden="true"><slot name="scene" /></div>}
  </div>

  {ticker?.length ? (
    <div class="ticker" aria-hidden="true">
      <div class="ticker-mask" data-loop>
        <ul class="ticker-track">
          {[0, 1].map(() => ticker.map((t) => <li>{t}<span class="sep">✦</span></li>))}
        </ul>
      </div>
    </div>
  ) : null}
</section>

<style>
  .page-intro { padding-top: clamp(40px, 7vw, 96px); }
  .page-intro:not(.has-ticker) { padding-bottom: clamp(40px, 6vw, 72px); border-bottom: 1px dashed var(--border); }
  .intro-grid { display: grid; gap: var(--s-6); align-items: center; }
  .intro-grid.with-scene { grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); }
  .intro-copy { display: grid; justify-items: start; gap: var(--s-3); }
  h1 { max-width: 18ch; font-size: var(--fs-h1); line-height: 1.04; animation: rise var(--dur-2) var(--ease) both; }
  .accent { position: relative; display: inline-block; padding-right: .06em; }
  .scribble { position: absolute; left: 0; right: 0; bottom: -.1em; width: 100%; height: .22em; overflow: visible; }
  .scribble path { fill: none; stroke: var(--saffron); stroke-width: 5; stroke-linecap: round; stroke-dasharray: 320; stroke-dashoffset: 320; animation: draw var(--dur-3) .3s var(--ease) forwards; }
  .lede { max-width: 56ch; color: var(--text-muted); font-size: clamp(1.05rem, 1rem + .3vw, 1.2rem); animation: rise var(--dur-2) .05s var(--ease) both; }
  .intro-copy > :global(:not(.label, h1, .lede)) { animation: rise var(--dur-2) .1s var(--ease) both; }
  .intro-scene { position: relative; min-height: 340px; animation: rise var(--dur-2) .12s var(--ease) both; }

  .ticker { margin-top: clamp(40px, 6vw, 80px); padding-block: var(--s-2); border-block: 1px dashed var(--border); }
  .ticker-mask { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .ticker-track { display: flex; width: max-content; margin: 0; padding: 0; list-style: none; animation: slide 36s linear infinite; }
  .ticker-track li { display: flex; align-items: center; gap: var(--s-3); padding-right: var(--s-3); color: var(--text); font: 700 1.1rem var(--font-display); letter-spacing: -.02em; white-space: nowrap; opacity: .75; }
  .sep { color: var(--saffron); font-size: .7rem; }

  @keyframes rise { from { opacity: 0; transform: translateY(var(--rise)); } }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes slide { to { transform: translateX(-50%); } }

  @media (max-width: 900px) {
    .intro-grid.with-scene { grid-template-columns: 1fr; gap: var(--s-4); }
    .intro-scene { min-height: 260px; width: 100%; max-width: 460px; margin-inline: auto; }
  }
  @media (max-width: 640px) {
    .intro-scene.desktop-only { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    h1, .lede, .intro-scene, .intro-copy > :global(*) { animation: none; }
    .scribble path { animation: none; stroke-dashoffset: 0; }
    .ticker-track { animation: none; }
  }
</style>
