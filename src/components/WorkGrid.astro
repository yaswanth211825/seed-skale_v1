---
import { projects, categories } from '../data/projects';
import ProjectMedia from './ProjectMedia.astro';

interface Props {
  limit?: number;
  filters?: boolean;
}
const { limit, filters = true } = Astro.props;
const list = limit ? projects.slice(0, limit) : projects;
---

<div class="work" data-work>
  {filters && (
    <div class="filters" role="group" aria-label="Filter projects">
      {categories.map((c, i) => (
        <button type="button" class="chip-btn" data-filter={c} aria-pressed={i === 0 ? 'true' : 'false'}>{c}</button>
      ))}
    </div>
  )}

  <ul class="grid" data-stagger>
    {list.map((p, i) => (
      <li class="tile" id={p.slug} data-cat={p.category}>
        <ProjectMedia project={p} index={i} />
        <div class="tile-body">
          <p class="meta"><span class="cat">{p.category}</span> · {p.sector}</p>
          <h3><a class="stretch" href={`/work/${p.slug}`}>{p.name}</a></h3>
          <p class="summary">{p.summary}</p>
          <p class="outcome">{p.outcome}</p>
          <div class="tile-foot">
            <span class="read">Read the story <span class="arrow" aria-hidden="true">→</span></span>
            {p.liveUrl ? (
              <a class="live" href={p.liveUrl} target="_blank" rel="noopener">Live site ↗</a>
            ) : (
              <span class="private">{p.slug === 'zerox' ? 'Taken down' : 'Private'}</span>
            )}
          </div>
        </div>
      </li>
    ))}
  </ul>
  <p class="empty" data-empty hidden>No projects in this category yet.</p>
</div>

<style>
  .filters { display: flex; gap: var(--s-1); overflow-x: auto; margin: 0 calc(var(--gutter) * -1) var(--s-4); padding: 0 var(--gutter) 4px; scrollbar-width: none; }
  .filters::-webkit-scrollbar { display: none; }
  .chip-btn {
    flex: none;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    font-weight: 500;
    cursor: pointer;
    transition: background var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out), border-color var(--t-fast) var(--ease-out);
  }
  .chip-btn[aria-pressed='true'] { background: var(--text); border-color: var(--text); color: var(--bg); }

  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-3); margin: 0; padding: 0; list-style: none; }
  .tile {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  .tile :global(.media) { border-bottom: 1px solid var(--border); }
  .tile.is-hidden { display: none; }
  .tile.is-entering { animation: enter .45s var(--ease-out) both; }

  .tile-body { display: grid; align-content: start; gap: var(--s-1); padding: var(--s-3); }
  .meta { color: var(--text-muted); font-size: var(--fs-small); }
  .cat { color: var(--label); font-weight: 700; }
  .tile h3 { font-size: var(--fs-h3); }
  .stretch { color: inherit; text-decoration: none; }
  .stretch::after { content: ''; position: absolute; inset: 0; z-index: 1; border-radius: inherit; }
  .stretch:focus-visible { outline: none; }
  .stretch:focus-visible::after { outline: 3px solid var(--saffron); outline-offset: -3px; }
  .summary { color: var(--text); }
  .outcome { color: var(--text-muted); font-size: .95rem; }
  .tile-foot { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); margin-top: var(--s-1); padding-top: var(--s-2); border-top: 1px solid var(--border); }
  .read { display: inline-flex; gap: 6px; color: var(--label); font-weight: 700; }
  .live {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text);
    background: var(--surface-raised);
    font-size: .875rem;
    font-weight: 600;
    text-decoration: none;
  }
  .private { color: var(--text-muted); font-size: .8rem; }
  .empty { color: var(--text-muted); }

  @keyframes enter { from { opacity: 0; transform: translateY(14px) scale(.98); } }

  @media (max-width: 1024px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .tile.is-entering { animation: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-work]').forEach((root) => {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const tiles = Array.from(root.querySelectorAll<HTMLElement>('[data-cat]'));
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const f = btn.dataset.filter;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        let shown = 0;
        tiles.forEach((t) => {
          const show = f === 'All' || t.dataset.cat === f;
          t.classList.toggle('is-hidden', !show);
          t.classList.remove('is-entering');
          if (show) {
            shown++;
            void t.offsetWidth;
            t.classList.add('is-entering', 'is-in');
          }
        });
        if (empty) empty.hidden = shown > 0;
      }),
    );
  });
</script>
