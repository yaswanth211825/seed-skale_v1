---
import { site } from '../data/site';

interface Props {
  heading?: 'h1' | 'h2';
}
const { heading = 'h2' } = Astro.props;
const Heading = heading;

const needs = ['a website', 'a web app or SaaS', 'Meta ads and SEO', 'Instagram content', 'not sure yet'];
const engines = [
  { id: 'chatgpt', label: 'ChatGPT', color: '#10a37f' },
  { id: 'claude', label: 'Claude', color: '#d97757' },
  { id: 'perplexity', label: 'Perplexity', color: '#20b8cd' },
];
---

<section class="section ask-ai dark panel" id="ask-ai" aria-labelledby="ask-title">
  <div class="container ask-grid">
    <div class="ask-copy" data-reveal>
      <p class="label">Ask AI about us</p>
      <Heading id="ask-title">Don't take our word for it. Ask your AI.</Heading>
      <p class="lede">
        Pick what you need, choose your assistant, and it opens with a ready-made question about SkaleSeed:
        what we do, what we have built, and whether we are a good fit for you.
      </p>
    </div>

    <div class="ask-card" data-reveal data-ask data-site={site.url} data-whatsapp={site.whatsappDisplay}>
      <fieldset class="needs">
        <legend>I'm looking for</legend>
        <div class="chips">
          {needs.map((n, i) => (
            <label class="chip">
              <input type="radio" name="ask-need" value={n} checked={i === 0} />
              <span>{n.replace(/^an? /, '').replace(/^\w/, (c) => c.toUpperCase())}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="field">
        <label for="ask-business">My business <small>(optional)</small></label>
        <input id="ask-business" type="text" maxlength="60" placeholder="e.g. a bakery in Kukatpally" autocomplete="off" />
      </div>

      <div class="engines">
        {engines.map((e) => (
          <button type="button" class="engine" data-engine={e.id} style={`--c:${e.color}`}>
            <span class="engine-dot" aria-hidden="true"></span>
            Ask {e.label}
            <span class="arrow" aria-hidden="true">↗</span>
          </button>
        ))}
      </div>

      <details class="preview">
        <summary>See the question we send</summary>
        <p data-prompt-preview></p>
        <button type="button" class="copy" data-copy>Copy question</button>
      </details>

      <p class="toast" role="status" aria-live="polite" data-toast></p>
    </div>
  </div>
</section>

<style>
  .ask-ai { position: relative; overflow: hidden; background: radial-gradient(ellipse at 85% 0%, rgb(53 99 255 / 16%), transparent 55%), var(--navy); }
  .ask-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: var(--s-6); align-items: center; }
  .ask-copy { display: grid; gap: var(--s-2); }
  .ask-copy #ask-title { font-size: var(--fs-h1); }
  .lede { color: var(--text-muted); font-size: 1.0625rem; max-width: 46ch; }

  .ask-card {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-4);
    border: 1px solid var(--border);
    border-radius: var(--r-panel);
    background: var(--surface);
    box-shadow: var(--shadow-dark);
  }
  .needs { margin: 0; padding: 0; border: 0; }
  legend, .field label { margin-bottom: var(--s-1); font-weight: 500; font-size: .95rem; }
  .field label small { color: var(--text-muted); font-weight: 400; }
  .chips { display: flex; flex-wrap: wrap; gap: var(--s-1); }
  .chip { position: relative; cursor: pointer; }
  .chip input { position: absolute; opacity: 0; pointer-events: none; }
  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-muted);
    font-size: .95rem;
    transition: background var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out), border-color var(--t-fast) var(--ease-out), transform var(--t-fast) var(--ease-out);
  }
  .chip:hover span { border-color: rgb(255 255 255 / 40%); color: var(--white); }
  .chip input:checked + span { background: var(--saffron); border-color: var(--saffron); color: var(--navy); font-weight: 600; }
  .chip input:focus-visible + span { outline: 3px solid var(--saffron); outline-offset: 3px; }
  .chip:active span { transform: scale(.96); }

  .field { display: grid; }
  .field input {
    min-height: 48px;
    padding: 12px 14px;
    border: 1.5px solid var(--border);
    border-radius: var(--r-control);
    background: var(--navy);
    color: var(--white);
    font: inherit;
    font-size: 1rem;
  }
  .field input::placeholder { color: rgb(185 198 214 / 65%); }
  .field input:focus { outline: none; border-color: var(--saffron); }

  .engines { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-1); }
  .engine {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 16px;
    border: 1px solid var(--border);
    border-radius: var(--r-control);
    background: var(--navy);
    color: var(--white);
    font: 600 .95rem var(--font-display);
    text-align: left;
    cursor: pointer;
    transition: border-color var(--t-fast) var(--ease-out), background var(--t-fast) var(--ease-out), transform var(--t-fast) var(--ease-out);
  }
  .engine:hover { border-color: var(--c); background: color-mix(in srgb, var(--c) 12%, var(--navy)); }
  .engine:active { transform: scale(.97); }
  .engine-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 22%, transparent); }
  .engine .arrow { margin-left: auto; color: var(--text-muted); transition: transform var(--t-base) var(--ease-out); }
  .engine:hover .arrow { transform: translate(2px, -2px); color: var(--white); }

  .preview { border-top: 1px solid var(--border); padding-top: var(--s-2); }
  .preview summary { display: inline-flex; align-items: center; min-height: 44px; color: var(--text-muted); cursor: pointer; }
  .preview summary:hover { color: var(--white); }
  .preview p { margin: var(--s-1) 0 var(--s-2); padding: var(--s-2); border-radius: var(--r-control); background: var(--navy); color: var(--text-muted); font-size: .9rem; white-space: pre-line; }
  .copy {
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--border);
    border-radius: var(--r-control);
    background: transparent;
    color: var(--white);
    cursor: pointer;
  }
  .copy:hover { border-color: var(--saffron); color: var(--saffron); }

  .toast { min-height: 1.4em; margin: 0; color: var(--saffron); font-size: var(--fs-small); }

  @media (max-width: 1024px) {
    .ask-grid { grid-template-columns: 1fr; gap: var(--s-4); }
  }
  @media (max-width: 480px) {
    .ask-card { padding: var(--s-3) var(--s-2); }
    .engines { grid-template-columns: 1fr; }
  }
</style>

<script>
  type Engine = 'chatgpt' | 'claude' | 'perplexity';

  document.querySelectorAll<HTMLElement>('[data-ask]').forEach((card) => {
    const url = card.dataset.site!;
    const wa = card.dataset.whatsapp!;
    const preview = card.querySelector<HTMLElement>('[data-prompt-preview]')!;
    const toast = card.querySelector<HTMLElement>('[data-toast]')!;
    const business = card.querySelector<HTMLInputElement>('#ask-business')!;

    const buildPrompt = () => {
      const need = card.querySelector<HTMLInputElement>('input[name="ask-need"]:checked')?.value ?? 'a website';
      const biz = business.value.trim().replace(/[<>]/g, '').slice(0, 60);
      const me = biz ? `I run ${/^(a|an|the)\s/i.test(biz) ? biz : `a ${biz}`}` : 'I run a small business';
      const lookingFor = need === 'not sure yet' ? 'help to grow online but I am not sure what I need yet' : need;
      return [
        `${me} and I'm looking for ${lookingFor}. I'm considering SkaleSeed (${url}), a web design, web app and digital marketing studio based in Hyderabad, India.`,
        `Please read ${url} and its Services, Work, How it works and Blog pages, then give me:`,
        `1. What SkaleSeed offers, in plain words.`,
        `2. How their process works, including the free demo page.`,
        `3. Real projects they have built and the results.`,
        `4. Whether they are a good fit for a business like mine, and what to ask them before starting.`,
        `Keep it short and practical. End with the quickest next step: request a free demo at ${url}/contact or message them on WhatsApp at ${wa}.`,
      ].join('\n');
    };

    const links: Record<Engine, (q: string) => string> = {
      chatgpt: (q) => `https://chatgpt.com/?hints=search&q=${encodeURIComponent(q)}`,
      claude: (q) => `https://claude.ai/new?q=${encodeURIComponent(q)}`,
      perplexity: (q) => `https://www.perplexity.ai/search?q=${encodeURIComponent(q)}`,
    };

    const say = (msg: string) => {
      toast.textContent = msg;
      window.setTimeout(() => { if (toast.textContent === msg) toast.textContent = ''; }, 6000);
    };

    const copy = async (text: string) => {
      try { await navigator.clipboard.writeText(text); return true; } catch { return false; }
    };

    const refresh = () => { preview.textContent = buildPrompt(); };
    card.addEventListener('change', refresh);
    business.addEventListener('input', refresh);
    refresh();

    card.querySelectorAll<HTMLButtonElement>('[data-engine]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const engine = btn.dataset.engine as Engine;
        const prompt = buildPrompt();
        window.open(links[engine](prompt), '_blank', 'noopener');
      });
    });

    card.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click', async () => {
      say((await copy(buildPrompt())) ? 'Question copied.' : 'Select the text above to copy it.');
    });
  });
</script>
