---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index?: number;
  eager?: boolean;
  /** Rendered width hint for responsive images. */
  sizes?: string;
}
const {
  project: p,
  index = 0,
  eager = false,
  sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 420px',
} = Astro.props;
const host = p.liveUrl ? new URL(p.liveUrl).host.replace(/^www\./, '') : `${p.name} · private build`;
---

{p.image && p.imageKind === 'screenshot' ? (
  <div class="media frame">
    <div class="chrome" aria-hidden="true">
      <i></i><i></i><i></i>
      <span class="url">{host}</span>
    </div>
    <div class="shot">
      <Image
        src={p.image}
        alt={`${p.name} website screenshot`}
        widths={[640, 960, 1280, 1600, 1920]}
        sizes={sizes}
        quality={88}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    </div>
  </div>
) : p.image ? (
  <div class="media photo">
    <Image
      src={p.image}
      alt={`${p.name}: ${p.summary}`}
      widths={[640, 960, 1280, 1600, 1920]}
      sizes={sizes}
      quality={85}
      loading={eager ? 'eager' : 'lazy'}
    />
    <span class="photo-tag">{p.category}</span>
  </div>
) : (
  <div class="media art" aria-hidden="true" style={`--hue:${(index * 47) % 360}`}>
    {p.slug === 'tradingfloor' ? (
      <svg class="chart" viewBox="0 0 320 160" preserveAspectRatio="none">
        <polyline points="0,120 30,110 60,118 90,90 120,96 150,70 180,78 210,52 240,60 270,34 300,40 320,22" />
        {[20, 60, 100, 140, 180, 220, 260, 300].map((x, i) => (
          <g class:list={['candle', { down: i % 3 === 1 }]}>
            <line x1={x} x2={x} y1={50 + ((i * 23) % 50)} y2={110 + ((i * 17) % 30)} />
            <rect x={x - 6} y={64 + ((i * 23) % 40)} width="12" height={22 + ((i * 11) % 18)} rx="2" />
          </g>
        ))}
      </svg>
    ) : (
      <span class="initial">{p.name.charAt(0)}</span>
    )}
    <span class="ring"></span>
  </div>
)}

<style>
  .media { position: relative; overflow: hidden; aspect-ratio: 16 / 9.5; background: var(--cream-2); }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .7s var(--ease-out); }

  /* Browser frame around real screenshots */
  .frame {
    display: grid;
    grid-template-rows: auto 1fr;
    padding: 14px 14px 0;
    background:
      radial-gradient(circle at 12% 0%, rgb(255 176 32 / 35%), transparent 55%),
      radial-gradient(circle at 100% 100%, rgb(53 99 255 / 14%), transparent 50%),
      var(--cream-2);
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 10px;
    border-radius: 10px 10px 0 0;
    background: var(--white);
    border-bottom: 1px solid rgb(11 31 58 / 8%);
  }
  .chrome i { width: 9px; height: 9px; border-radius: 50%; background: #c6cfdc; }
  .chrome i:nth-child(1) { background: #ff6b5e; }
  .chrome i:nth-child(2) { background: #ffbd2e; }
  .chrome i:nth-child(3) { background: #28c840; }
  .url {
    flex: 1;
    max-width: 60%;
    margin-left: 8px;
    padding: 2px 10px;
    overflow: hidden;
    border-radius: 6px;
    background: var(--cream);
    color: #4f5966;
    font-size: .68rem;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .shot { overflow: hidden; background: var(--white); box-shadow: 0 -4px 24px rgb(60 40 0 / 14%); }
  .shot :global(img) { object-position: top center; }

  /* Full-bleed photos */
  .photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 50%, rgb(11 31 58 / 55%)); }
  .photo-tag {
    position: absolute;
    z-index: 1;
    left: 14px;
    bottom: 12px;
    padding: 4px 12px;
    border-radius: 999px;
    background: rgb(11 31 58 / 70%);
    color: var(--white);
    font-size: .78rem;
    font-weight: 600;
  }

  /* Drawn art for projects without public images */
  .art {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 20% 20%, hsl(var(--hue) 80% 60% / 30%), transparent 50%),
      radial-gradient(circle at 85% 90%, rgb(255 176 32 / 25%), transparent 45%),
      linear-gradient(135deg, var(--navy-3), var(--navy));
  }
  .initial { font: 800 3.5rem var(--font-display); color: rgb(255 255 255 / 85%); transition: transform .6s var(--ease-out); }
  .ring { position: absolute; width: 60%; aspect-ratio: 1; border: 1px dashed rgb(255 255 255 / 18%); border-radius: 50%; transition: transform .8s var(--ease-out); }
  .chart { position: absolute; inset: 18% 8%; width: 84%; height: 64%; overflow: visible; }
  .chart polyline { fill: none; stroke: var(--saffron); stroke-width: 2.5; stroke-linejoin: round; opacity: .9; }
  .candle line { stroke: rgb(255 255 255 / 45%); stroke-width: 1.5; }
  .candle rect { fill: #28c840; opacity: .85; }
  .candle.down rect { fill: var(--coral); }

  /* Scroll-in: image settles from a slight zoom as its card reveals */
  :global(.js [data-reveal]:not(.is-in)) .media :global(img) { transform: scale(1.12); }
  :global(.js [data-reveal]:not(.is-in)) .ring { transform: rotate(-40deg) scale(.8); }
  .media :global(img) { transition: transform 1.2s var(--ease-out); }

  @media (prefers-reduced-motion: reduce) {
    .media :global(img), .initial, .ring { transition: none; }
  }
</style>
