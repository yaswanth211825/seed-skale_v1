---
import type { SocialId } from '../data/site';

interface Props {
  id: SocialId;
  size?: number;
}
const { id, size = 20 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {id === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.3" cy="6.7" r=".6" fill="currentColor" />
    </>
  )}
  {id === 'linkedin' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="3" />
      <path d="M7.5 10.5v6M7.5 7.5v.01M11.5 16.5v-6M11.5 13.2c0-1.6 1-2.7 2.4-2.7s2.1 1 2.1 2.6v3.4" />
    </>
  )}
  {id === 'youtube' && (
    <>
      <rect x="2.5" y="5.5" width="19" height="13" rx="4" />
      <path d="M10.3 9.3v5.4l4.6-2.7z" fill="currentColor" />
    </>
  )}
  {id === 'x' && <path d="M4 4l16 16M20 4L4 20" />}
  {id === 'facebook' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <path d="M15.5 8.5h-1.7a2 2 0 0 0-2 2V21M9.5 13.5h5" />
    </>
  )}
  {id === 'email' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="3" />
      <path d="M4 7l8 6 8-6" />
    </>
  )}
  {id === 'whatsapp' && (
    <>
      <path d="M20.5 11.6a8.4 8.4 0 0 1-12.4 7.4L3.5 20.5 5 16.1A8.4 8.4 0 1 1 20.5 11.6z" />
      <path d="M9.2 8.6c.2-.4.5-.4.8-.4h.4c.2 0 .3.1.4.3l.7 1.6c.1.2 0 .4-.1.5l-.5.6c-.1.1-.1.3 0 .5a6 6 0 0 0 2.6 2.4c.2.1.4.1.5-.1l.6-.6c.1-.1.3-.2.5-.1l1.6.7c.2.1.3.3.3.5 0 .6-.3 1.3-1 1.6-.8.4-1.9.3-3.4-.4a9.8 9.8 0 0 1-3.6-3.4c-.8-1.3-.9-2.7-.6-3.3z" fill="currentColor" stroke="none" />
    </>
  )}
</svg>
