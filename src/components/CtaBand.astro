---
import { cta, whatsappLink } from '../data/site';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'See your website before you pay.',
  text = 'Tell us about your business. We send back a sample page with your name on it, free.',
} = Astro.props;
---

<section class="cta-band panel" aria-labelledby="cta-title">
  <div class="container cta-inner">
    <div>
      <h2 id="cta-title">{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-actions">
      <a class="btn cta-primary" href={cta.href}>{cta.label}</a>
      <a class="cta-link" href={whatsappLink()} target="_blank" rel="noopener">or chat on WhatsApp</a>
    </div>
  </div>
</section>

<style>
  .cta-band { margin-bottom: clamp(8px, 1.4vw, 20px); background: radial-gradient(ellipse at 100% 0%, rgb(255 255 255 / 35%), transparent 55%), var(--saffron); color: var(--navy); padding-block: clamp(56px, 7vw, 96px); }
  .cta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }
  h2 { font-size: var(--fs-h2); max-width: 18ch; }
  p { margin-top: var(--s-1); max-width: 52ch; color: rgb(11 31 58 / 78%); }
  .cta-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-3); }
  .cta-primary { background: var(--navy); color: var(--white); }
  .cta-primary:hover { background: var(--navy-3); }
  .cta-band :focus-visible { outline-color: var(--navy); }
  .cta-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  @media (max-width: 560px) {
    .cta-actions, .cta-primary { width: 100%; }
  }
</style>
