---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const engines = [
  { label: 'ChatGPT', color: '#10a37f' },
  { label: 'Claude', color: '#d97757' },
  { label: 'Gemini', color: '#4f7cff' },
  { label: 'Perplexity', color: '#20b8cd' },
];
---

<aside class:list={['teaser', 'dark', { compact }]} data-reveal="zoom" aria-label="Ask AI about SkaleSeed">
  <div class="copy">
    <p class="label">Ask AI about us</p>
    <p class="title">Not sure yet? Ask your favourite AI what it thinks of SkaleSeed.</p>
  </div>
  <ul class="engines" aria-hidden="true">
    {engines.map((e) => <li style={`--c:${e.color}`}>{e.label}</li>)}
  </ul>
  <a class="btn btn-primary" href="/ask-ai">Ask AI <span class="arrow" aria-hidden="true">→</span></a>
</aside>

<style>
  .teaser {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-4);
    border: 1px solid var(--border);
    border-radius: var(--r-panel);
    background: radial-gradient(ellipse at 100% 0%, rgb(53 99 255 / 22%), transparent 60%), var(--navy-2);
    color: var(--white);
  }
  .copy { display: grid; gap: 6px; }
  .label { color: var(--saffron); }
  .title { font: 700 clamp(1.15rem, 1rem + .6vw, 1.5rem)/1.3 var(--font-display); max-width: 32ch; }
  .engines { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .engines li { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: rgb(255 255 255 / 7%); color: var(--text-muted); font-size: .85rem; }
  .engines li::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--c); }
  .teaser :focus-visible { outline-color: var(--saffron); }
  @media (max-width: 900px) {
    .teaser { grid-template-columns: 1fr; justify-items: start; }
  }
  @media (max-width: 480px) {
    .teaser { padding: var(--s-3) var(--s-2); }
    .teaser .btn { width: 100%; }
  }
</style>
