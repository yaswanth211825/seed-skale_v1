---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import AskAITeaser from '../../components/AskAITeaser.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
import { sortPosts, themeFor, iconFor, minutes, stepCount, fmtDate } from '../../data/blog';

const posts = sortPosts(await getCollection('blog', ({ data }) => !data.draft));
const topics = [...new Set(posts.map((p) => p.data.tags[0]))];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'SkaleSeed Field Notes',
    url: `${site.url}/blog`,
    publisher: { '@id': `${site.url}/#org` },
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      url: `${site.url}/blog/${p.id}`,
      datePublished: p.data.published.toISOString(),
    })),
  },
];
---

<BaseLayout
  title="Field Notes: guides to growing online | SkaleSeed Blog"
  description="Free, step-by-step guides to taking a business online: websites, online orders, AI, SEO and growth, with real examples from SkaleSeed projects."
  schema={schema}
>
  <section class="fn-hero">
    <div class="fn-hero-card">
      <div class="masthead">
        <span class="mark"><Icon name="lightbulb" weight="fill" size={16} />SkaleSeed Field Notes</span>
        <a class="rss" href="/rss.xml"><Icon name="rss-simple" weight="fill" size={14} />RSS</a>
      </div>
      <h1 data-no-split>Grow online, <span class="hl">one step</span> at a time.</h1>
      <p class="lede">Free, no-jargon guides for business owners. Every step comes with what we actually built for a real client.</p>

      <div class="tools" data-blog-tools>
        <label class="search">
          <Icon name="magnifying-glass" weight="bold" size={18} />
          <span class="sr-only">Search the guides</span>
          <input type="search" placeholder="Search guides… try “Google”" data-blog-search autocomplete="off" />
        </label>
        <div class="topics" role="group" aria-label="Filter by topic">
          <button type="button" aria-pressed="true" data-topic="">All</button>
          {topics.map((t) => <button type="button" aria-pressed="false" data-topic={t}>{t}</button>)}
        </div>
      </div>

      <span class="sticker st1" aria-hidden="true">100% free ✦</span>
      <span class="sticker st2" aria-hidden="true">Real projects inside</span>
      <span class="sticker st3" aria-hidden="true">No jargon</span>
    </div>
  </section>

  <section class="fn-list">
    <div class="container">
      <h2 class="sr-only">All guides</h2>
      <ul class="cards" data-blog-list>
        {posts.map((post, i) => {
          const th = themeFor(post);
          const steps = stepCount(post.body);
          return (
            <li
              class:list={['card', { feat: i === 0 }]}
              style={`--bg:${th.bg};--ink:${th.ink};--pop:${th.pop}`}
              data-card
              data-topic={post.data.tags[0]}
              data-text={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')} ${[...(post.body ?? '').matchAll(/^##\s+(.+)$/gm)].map((m) => m[1]).join(' ')}`.toLowerCase()}
            >
              <a class="card-link-area" href={`/blog/${post.id}`}>
                <div class="card-top">
                  <span class="badge"><Icon name={iconFor(post)} weight="fill" size={14} />{post.data.tags[0]}</span>
                  {i === 0 && <span class="badge new">Latest</span>}
                </div>
                <h3>{post.data.title}</h3>
                <p class="desc">{post.data.description}</p>
                <p class="meta">
                  <time datetime={post.data.published.toISOString()}>{fmtDate(post.data.published)}</time>
                  <span>·</span>{minutes(post.body)} min read
                </p>
                <span class="go">Read the guide <Icon name="arrow-up-right" weight="bold" size={16} /></span>
                {steps > 0 && (
                  <span class="steps" aria-hidden="true"><b>{steps}</b>steps</span>
                )}
                {i === 0 && steps > 0 && (
                  <div class="peek" aria-hidden="true">
                    <p class="peek-h">Inside this guide</p>
                    {[...(post.body ?? '').matchAll(/^##\s+Step\s+(\d+)\s*[:.-]\s*(.+)$/gim)].slice(0, 4).map(([, n, title], k) => (
                      <span class:list={['peek-row', { ticked: k < 2 }]}><b>{n}</b>{title}</span>
                    ))}
                    <span class="peek-more">+ {steps - 4} more steps</span>
                  </div>
                )}
              </a>
            </li>
          );
        })}
        <li class="card cta-card" data-cta-card>
          <div class="cta-inner">
            <span class="badge dark">Shortcut</span>
            <h3>Skip the reading. <em>We'll do it for you.</em></h3>
            <p>Tell us about your business and get a free demo page with your name on it.</p>
            <a class="cta-btn" href="/contact" data-cta="blog-list">Get my free demo <span aria-hidden="true">→</span></a>
          </div>
        </li>
      </ul>
      <p class="empty" data-blog-empty hidden>
        No guide matches that yet. <a href="/contact">Ask us directly</a> and we will answer, or <button type="button" data-blog-reset>show all guides</button>.
      </p>

      <div class="teaser"><AskAITeaser /></div>
    </div>
  </section>

  <CtaBand title="Reading is good. Launching is better." text="Tell us what you do. We send a free demo page with your business name on it, before you pay anything." />
</BaseLayout>

<style>
  /* Field Notes: louder than the rest of the site. Chunky outlines, hard shadows, bright blocks. */
  .fn-hero { padding: clamp(16px, 3vw, 32px) clamp(8px, 1.4vw, 20px) 0; }
  .fn-hero-card {
    position: relative;
    display: grid;
    justify-items: start;
    gap: var(--s-3);
    max-width: 1320px;
    margin-inline: auto;
    padding: clamp(28px, 5vw, 72px) clamp(20px, 5vw, 72px) clamp(28px, 4vw, 56px);
    border: 2.5px solid var(--navy);
    border-radius: 32px;
    background:
      radial-gradient(circle at 88% 12%, rgb(255 255 255 / 55%), transparent 30%),
      repeating-linear-gradient(-45deg, transparent 0 22px, rgb(11 31 58 / 3.5%) 22px 24px),
      #ffd36b;
    box-shadow: 8px 8px 0 var(--navy);
    color: var(--navy);
  }
  .masthead { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-2); width: 100%; }
  .mark { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border: 2px solid var(--navy); border-radius: 999px; background: #fff; font: 800 .85rem var(--font-display); letter-spacing: .04em; text-transform: uppercase; }
  .rss { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding-inline: 4px; color: var(--navy); font-weight: 700; font-size: .9rem; text-decoration: underline; text-underline-offset: 4px; }
  h1 { max-width: 15ch; font: 850 clamp(2.6rem, 1.4rem + 5.6vw, 6rem)/.98 var(--font-display); letter-spacing: -.045em; animation: rise var(--dur-2) var(--ease) both; }
  .hl { position: relative; display: inline-block; padding: 0 .12em; color: #fff; z-index: 0; }
  .hl::before { content: ''; position: absolute; inset: .08em -.02em .02em; z-index: -1; border-radius: .18em; background: var(--navy); rotate: -2deg; animation: swipe var(--dur-2) .25s var(--ease) both; transform-origin: left; }
  .lede { max-width: 48ch; font-size: clamp(1.05rem, 1rem + .4vw, 1.3rem); font-weight: 500; animation: rise var(--dur-2) .05s var(--ease) both; }

  .tools { display: grid; gap: var(--s-2); width: 100%; max-width: 760px; margin-top: var(--s-1); animation: rise var(--dur-2) .1s var(--ease) both; }
  .search { display: flex; align-items: center; gap: 10px; padding: 0 18px; border: 2px solid var(--navy); border-radius: 16px; background: #fff; box-shadow: 4px 4px 0 var(--navy); transition: box-shadow var(--dur-1) var(--ease), translate var(--dur-1) var(--ease); }
  .search:focus-within { translate: -2px -2px; box-shadow: 6px 6px 0 var(--navy); }
  .search input { flex: 1; min-width: 0; min-height: 54px; border: 0; outline: 0; background: transparent; color: var(--navy); font: 600 1rem var(--font-body); }
  .search input::placeholder { color: #6b7380; }
  .topics { display: flex; flex-wrap: wrap; gap: 8px; }
  .topics button { min-height: 44px; padding: 0 18px; border: 2px solid var(--navy); border-radius: 999px; background: rgb(255 255 255 / 70%); color: var(--navy); font: 700 .92rem var(--font-display); cursor: pointer; transition: background var(--dur-1) var(--ease), translate var(--dur-1) var(--ease); }
  .topics button:hover { translate: 0 -2px; }
  .topics button[aria-pressed='true'] { background: var(--navy); color: #ffd36b; }

  .sticker { position: absolute; padding: 8px 16px; border: 2px solid var(--navy); border-radius: 999px; font: 800 .85rem var(--font-display); white-space: nowrap; box-shadow: 3px 3px 0 var(--navy); animation: wobble 5s ease-in-out infinite; }
  .st1 { top: 13%; right: 6%; background: #ff6b4a; color: #fff; rotate: 8deg; }
  .st2 { top: 40%; right: 3%; background: #9ff0c8; color: var(--navy); rotate: -5deg; animation-delay: -1.6s; }
  .st3 { bottom: 14%; right: 9%; background: #c9b8ff; color: var(--navy); rotate: 4deg; animation-delay: -3.2s; }

  .fn-list { padding-block: clamp(40px, 6vw, 72px) var(--section-y); }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(18px, 2.4vw, 28px); margin: 0; padding: 0; list-style: none; }
  .card { position: relative; display: grid; border: 2.5px solid var(--navy); border-radius: 26px; background: var(--bg); color: var(--ink); box-shadow: 6px 6px 0 var(--navy); transition: translate var(--dur-1) var(--ease), box-shadow var(--dur-1) var(--ease); }
  .card:hover { translate: -3px -3px; box-shadow: 9px 9px 0 var(--navy); }
  .card:active { translate: 3px 3px; box-shadow: 2px 2px 0 var(--navy); }
  .card-link-area { position: relative; display: grid; align-content: start; gap: var(--s-2); height: 100%; padding: clamp(22px, 2.6vw, 32px); overflow: hidden; border-radius: inherit; color: inherit; text-decoration: none; }
  .card-link-area:focus-visible { outline: 3px solid var(--blue); outline-offset: 4px; }
  .card-top { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: 8px; }
  .badge { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border: 2px solid var(--navy); border-radius: 999px; background: #fff; font: 800 .78rem var(--font-display); }
  .badge.new { background: var(--navy); color: #fff; }
  .badge.dark { background: var(--saffron); color: var(--navy); }
  .card h3 { position: relative; z-index: 1; max-width: 22ch; font: 850 clamp(1.4rem, 1.1rem + 1vw, 1.9rem)/1.12 var(--font-display); letter-spacing: -.03em; }
  .desc { position: relative; z-index: 1; max-width: 52ch; color: rgb(11 31 58 / 82%); }
  .meta { display: flex; gap: 8px; color: rgb(11 31 58 / 75%); font-size: .875rem; font-weight: 600; }
  .go { display: inline-flex; align-items: center; gap: 6px; margin-top: auto; padding-top: var(--s-1); font: 800 1rem var(--font-display); text-decoration: underline; text-decoration-color: var(--pop); text-decoration-thickness: 3px; text-underline-offset: 5px; }
  .card:hover .go :global(svg) { rotate: 45deg; }
  .go :global(svg) { transition: rotate var(--dur-1) var(--ease); }
  .steps { position: absolute; right: -6px; bottom: -22px; display: grid; justify-items: end; color: rgb(11 31 58 / 12%); font: 900 1rem/1 var(--font-display); text-transform: uppercase; letter-spacing: .1em; pointer-events: none; }
  .steps b { font-size: 9rem; letter-spacing: -.06em; line-height: .9; }

  .card.feat { grid-column: 1 / -1; }
  .card.feat .card-link-area { grid-template-columns: minmax(0, 1fr); padding: clamp(28px, 4vw, 56px); padding-right: clamp(28px, 22vw, 340px); }
  .card.feat h3 { font-size: clamp(1.9rem, 1.2rem + 2.6vw, 3.4rem); max-width: 18ch; }
  .card.feat .steps b { font-size: clamp(9rem, 16vw, 16rem); }
  .card.feat .steps { color: rgb(11 31 58 / 14%); right: 12px; bottom: -28px; }

  .peek { position: absolute; z-index: 1; top: 50%; right: clamp(28px, 4vw, 56px); display: grid; gap: 8px; width: min(36%, 380px); padding: 18px; border: 2.5px solid var(--navy); border-radius: 20px; background: #fff; box-shadow: 5px 5px 0 var(--navy); rotate: 2deg; translate: 0 -50%; transition: rotate var(--dur-2) var(--ease); }
  .card:hover .peek { rotate: 0deg; }
  .card:not(.feat) .peek { display: none; }
  .peek-h { font: 800 .75rem var(--font-display); letter-spacing: .08em; text-transform: uppercase; color: #6b7380; }
  .peek-row { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-top: 1.5px dashed rgb(11 31 58 / 15%); font-size: .92rem; font-weight: 700; line-height: 1.3; }
  .peek-row b { flex: none; display: grid; place-items: center; width: 26px; height: 26px; border: 2px solid var(--navy); border-radius: 8px; background: var(--bg); font-size: .78rem; }
  .peek-row.ticked { color: #6b7380; text-decoration: line-through; text-decoration-color: var(--pop); text-decoration-thickness: 2px; }
  .peek-row.ticked b { background: var(--navy); color: var(--saffron); }
  .peek-more { font-size: .85rem; font-weight: 700; color: var(--pop); filter: brightness(.7); }
  .cta-card { background: var(--navy); color: #fff; }
  .cta-inner .badge { justify-self: start; }
  .cta-card:hover { translate: none; box-shadow: 6px 6px 0 var(--navy); }
  .cta-card:active { translate: none; }
  .cta-inner { display: grid; align-content: start; gap: var(--s-2); padding: clamp(22px, 2.6vw, 32px); }
  .cta-card h3 { font: 850 clamp(1.4rem, 1.1rem + 1vw, 1.9rem)/1.12 var(--font-display); letter-spacing: -.03em; }
  .cta-card h3 em { display: block; color: var(--saffron); }
  .cta-card p { color: #c7d2e0; }
  .cta-btn { justify-self: start; display: inline-flex; align-items: center; gap: 8px; min-height: 48px; margin-top: var(--s-1); padding: 0 20px; border: 2px solid #fff; border-radius: 14px; background: var(--saffron); color: var(--navy); font: 800 1rem var(--font-display); text-decoration: none; box-shadow: 4px 4px 0 #fff; transition: translate var(--dur-1) var(--ease), box-shadow var(--dur-1) var(--ease); }
  .cta-btn:hover { translate: -2px -2px; box-shadow: 6px 6px 0 #fff; }

  .empty { margin-top: var(--s-4); padding: var(--s-3); border: 2px dashed var(--navy); border-radius: 18px; font-weight: 600; text-align: center; }
  .empty a, .empty button { color: #2443c4; font: inherit; text-decoration: underline; background: none; border: 0; padding: 0; cursor: pointer; }
  .teaser { margin-top: clamp(40px, 6vw, 72px); }

  @keyframes rise { from { opacity: 0; transform: translateY(var(--rise)); } }
  @keyframes swipe { from { transform: scaleX(0); } }
  @keyframes wobble { 50% { translate: 0 -5px; } }

  @media (max-width: 1100px) {
    .sticker { display: none; }
  }
  @media (max-width: 960px) {
    .cards { grid-template-columns: 1fr 1fr; }
    .card.feat .card-link-area { padding-right: clamp(28px, 4vw, 56px); }
    .card.feat .steps b { font-size: 9rem; }
    .peek { display: none; }
  }
  @media (max-width: 640px) {
    .cards { grid-template-columns: 1fr; }
    .fn-hero-card { box-shadow: 5px 5px 0 var(--navy); border-radius: 24px; }
    .card { box-shadow: 4px 4px 0 var(--navy); }
    .steps b { font-size: 7rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    h1, .lede, .tools, .hl::before, .sticker { animation: none; }
    .card, .card:hover, .card:active { translate: none; }
  }
</style>

<script>
  // Live search + topic filter. Works without JS too: everything is simply listed.
  const input = document.querySelector<HTMLInputElement>('[data-blog-search]');
  const topicBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-topic]')).filter((b) => b.tagName === 'BUTTON');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'));
  const empty = document.querySelector<HTMLElement>('[data-blog-empty]');
  const ctaCard = document.querySelector<HTMLElement>('[data-cta-card]');
  let topic = '';

  const apply = () => {
    const q = (input?.value ?? '').trim().toLowerCase();
    let shown = 0;
    cards.forEach((c) => {
      const ok = (!topic || c.dataset.topic === topic) && (!q || (c.dataset.text ?? '').includes(q));
      c.hidden = !ok;
      if (ok) shown += 1;
    });
    const filtering = Boolean(q || topic);
    cards.forEach((c, i) => c.classList.toggle('feat', !filtering && i === 0));
    if (empty) empty.hidden = shown > 0;
    if (ctaCard) ctaCard.hidden = shown === 0;
  };

  input?.addEventListener('input', apply);
  topicBtns.forEach((b) =>
    b.addEventListener('click', () => {
      topic = b.dataset.topic ?? '';
      topicBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      apply();
    }),
  );
  document.querySelector('[data-blog-reset]')?.addEventListener('click', () => {
    if (input) input.value = '';
    topic = '';
    topicBtns.forEach((x, i) => x.setAttribute('aria-pressed', String(i === 0)));
    apply();
  });
</script>
