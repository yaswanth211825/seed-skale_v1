---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import CtaBand from '../../components/CtaBand.astro';
import AskAITeaser from '../../components/AskAITeaser.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
const fmt = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
const minutes = (text = '') => Math.max(1, Math.round(text.split(/\s+/).length / 220));
---

<BaseLayout
  title="Blog | SkaleSeed"
  description="Step-by-step guides to taking a business digital: websites, online orders, AI, SEO and growth, with real examples from our projects."
>
  <PageIntro
    label="Blog"
    title="Guides for growing online."
    lede="Step-by-step guides to taking your business digital, with what we actually did for real clients at every step."
  />

  <section class="section">
    <div class="container">
      <ul class="posts" data-stagger>
        {posts.map((post) => (
          <li>
            <a class="post lift" href={`/blog/${post.id}`}>
              <p class="meta">
                <time datetime={post.data.published.toISOString()}>{fmt(post.data.published)}</time>
                · {minutes(post.body)} min read
              </p>
              <h2>{post.data.title}</h2>
              <p class="desc">{post.data.description}</p>
              <ul class="tags">{post.data.tags.map((t) => <li>{t}</li>)}</ul>
              <span class="read">Read the guide <span class="arrow" aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
      <div class="teaser-wrap"><AskAITeaser /></div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .posts { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-3); margin: 0; padding: 0; list-style: none; }
  .post {
    display: grid;
    align-content: start;
    gap: var(--s-2);
    height: 100%;
    padding: var(--s-4);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    color: inherit;
    text-decoration: none;
  }
  .post:hover { border-color: rgb(255 176 32 / 50%); }
  .teaser-wrap { margin-top: var(--s-6); }
  .meta { color: var(--text-muted); font-size: var(--fs-small); }
  .post h2 { font-size: var(--fs-h3); line-height: 1.3; }
  .desc { color: var(--text-muted); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .tags li { padding: 4px 10px; border-radius: 999px; background: var(--chip); color: var(--text-muted); font-size: .8rem; }
  .read { display: inline-flex; gap: 6px; margin-top: var(--s-1); color: var(--label); font-weight: 700; }
  .read .arrow { transition: transform var(--t-base) var(--ease-out); }
  .post:hover .read .arrow { transform: translateX(4px); }
  @media (max-width: 960px) {
    .posts { grid-template-columns: 1fr; }
    .post { padding: var(--s-3); }
  }
</style>
