---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import AskAITeaser from '../../components/AskAITeaser.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const url = new URL(`/blog/${post.id}`, site.url).href;
const fmt = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
const minutes = Math.max(1, Math.round((post.body ?? '').split(/\s+/).length / 220));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.published.toISOString(),
    dateModified: (post.data.updated ?? post.data.published).toISOString(),
    mainEntityOfPage: url,
    url,
    keywords: post.data.tags.join(', '),
    author: { '@type': 'Organization', name: site.name, url: site.url },
    publisher: { '@id': `${site.url}/#org` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site.url}/blog` },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];
---

<BaseLayout title={`${post.data.title} | SkaleSeed`} description={post.data.description} schema={schema} type="article">
  <article>
    <header class="post-head">
      <div class="container narrow">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/blog">Blog</a> <span aria-hidden="true">/</span> <span>{post.data.tags[0]}</span></nav>
        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.description}</p>
        <p class="meta">
          <time datetime={post.data.published.toISOString()}>{fmt(post.data.published)}</time> · {minutes} min read · By the SkaleSeed team
        </p>
      </div>
    </header>
    <div class="section light prose-wrap">
      <div class="container narrow prose">
        <Content />
      </div>
      <div class="container narrow after">
        <AskAITeaser />
      </div>
    </div>
  </article>
  <CtaBand />
</BaseLayout>

<style>
  .narrow { max-width: 760px; }
  .post-head { padding-block: clamp(48px, 7vw, 96px) var(--s-6); }
  .post-head .container { display: grid; gap: var(--s-2); }
  .crumbs { display: flex; gap: 8px; color: var(--text-muted); font-size: var(--fs-small); }
  .crumbs a { color: var(--label); font-weight: 600; text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  h1 { font-size: var(--fs-h1); }
  .lede { color: var(--text-muted); font-size: 1.125rem; }
  .meta { color: var(--text-muted); font-size: var(--fs-small); }

  .prose { font-size: 1.0625rem; line-height: 1.75; color: var(--light-text); }
  .prose :global(h2) { margin: var(--s-6) 0 var(--s-2); font-size: var(--fs-h3); }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 var(--s-2); color: #2c3d52; }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(a) { color: #2443c4; text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .prose :global(strong) { color: var(--navy); }
  .prose :global(code) { padding: 2px 6px; border-radius: 6px; background: #e6ebf3; font-size: .9em; }
  .prose :global(> :first-child) { margin-top: 0; }
  .prose :global(h2) { scroll-margin-top: calc(var(--header-h) + 24px); }
  /* "What we did" callouts */
  .prose :global(blockquote) {
    position: relative;
    margin: var(--s-3) 0 var(--s-4);
    padding: var(--s-3) var(--s-3) var(--s-2) var(--s-3);
    border: 1px solid var(--light-border);
    border-radius: var(--r-card);
    background: var(--white);
    box-shadow: var(--shadow-light);
  }
  .prose :global(blockquote::before) {
    content: '';
    position: absolute;
    top: 18px;
    bottom: 18px;
    left: 0;
    width: 4px;
    border-radius: 0 4px 4px 0;
    background: var(--saffron);
  }
  .prose :global(blockquote p) { color: #2c3d52; }
  .prose :global(blockquote p:first-child strong:first-child) { color: var(--blue); }
  .after { margin-top: var(--s-6); }
</style>
