---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { site, whatsappLink } from '../data/site';

const needs = ['Website', 'Web app or SaaS', 'AI assistant', 'Meta ads and SEO', 'Instagram content', 'Not sure yet'];
---

<BaseLayout
  title="Get a free demo | SkaleSeed"
  description="Tell SkaleSeed about your business and get a free sample page with your name on it. No cost, no pressure."
>
  <PageIntro
    label="Free demo"
    title="See your website before you pay."
    lede="Tell us about your business. We reply on WhatsApp with the next step and a sample page for you to look at."
  />

  <section class="section">
    <div class="container contact-grid">
      <div>
        <form class="form-card" action={site.formEndpoint} method="POST" data-form data-success="contact-success" novalidate>
          <input type="hidden" name="_subject" value="New free demo request" />
          <input type="hidden" name="project_reference" value="" data-ref />
          <div class="f-trap" aria-hidden="true"><label>Leave empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label></div>

          <div class="f-row">
            <div class="f-field">
              <label class="f-label" for="name">Your name</label>
              <input class="f-input" id="name" name="name" data-rule="name" required autocomplete="name" maxlength="80" placeholder="Your full name" />
              <small class="f-error" id="name-error"></small>
            </div>
            <div class="f-field">
              <label class="f-label" for="business">Business name <small>(optional)</small></label>
              <input class="f-input" id="business" name="business" data-rule="text" autocomplete="organization" maxlength="120" placeholder="Sample Biryani House" />
              <small class="f-error" id="business-error"></small>
            </div>
          </div>

          <div class="f-row">
            <div class="f-field">
              <label class="f-label" for="phone">WhatsApp number</label>
              <input class="f-input" id="phone" name="phone" type="tel" inputmode="tel" data-rule="phone" required autocomplete="tel" maxlength="20" placeholder="+91 98765 43210" />
              <small class="f-error" id="phone-error"></small>
            </div>
            <div class="f-field">
              <label class="f-label" for="email">Email <small>(optional)</small></label>
              <input class="f-input" id="email" name="email" type="email" inputmode="email" data-rule="email" autocomplete="email" maxlength="254" placeholder="you@example.com" />
              <small class="f-error" id="email-error"></small>
            </div>
          </div>

          <fieldset class="f-chips">
            <legend class="f-label">What do you need?</legend>
            {needs.map((n, i) => (
              <label class="f-chip">
                <input type="radio" name="need" value={n} checked={i === 0} />
                <span>{n}</span>
              </label>
            ))}
          </fieldset>

          <div class="f-field">
            <label class="f-label" for="message">Tell us about your business</label>
            <textarea class="f-input" id="message" name="message" data-rule="message" required maxlength="1000" placeholder="What do you do, and what would you like help with?"></textarea>
            <small class="f-error" id="message-error"></small>
          </div>

          <button class="btn btn-primary" type="submit">Send my request <span class="arrow" aria-hidden="true">→</span></button>
          <p class="f-status" data-status role="status" aria-live="polite"></p>
        </form>

        <div class="f-success" id="contact-success" tabindex="-1" hidden>
          <span class="f-tick" aria-hidden="true">✓</span>
          <h2>Thank you. Your request is in.</h2>
          <p>We will message you on WhatsApp shortly with the next step and your free demo page.</p>
          <a class="btn btn-primary" href="/work">See our work while you wait <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>

      <aside class="contact-side">
        <h2>Prefer to talk?</h2>
        <p>Message us on WhatsApp and a real person from the team replies.</p>
        <a class="btn btn-secondary" href={whatsappLink()} target="_blank" rel="noopener">Chat on WhatsApp</a>
        <ul>
          <li>Free sample page, no payment</li>
          <li>Reply on WhatsApp</li>
          <li>Based in {site.location}</li>
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/forms.ts';
  // Arriving from a case study: prefill the message with that project.
  const project = new URLSearchParams(location.search).get('project')?.replace(/[<>]/g, '').slice(0, 60);
  if (project) {
    const msg = document.querySelector<HTMLTextAreaElement>('#message');
    const ref = document.querySelector<HTMLInputElement>('[data-ref]');
    if (msg && !msg.value) msg.value = `I saw your ${project} project. I have a similar problem: `;
    if (ref) ref.value = project;
  }
</script>

<style>
  .contact-grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, .7fr); gap: var(--s-6); align-items: start; }
  .contact-side { position: sticky; top: calc(var(--header-h) + 32px); display: grid; justify-items: start; gap: var(--s-2); padding-top: var(--s-2); }
  .contact-side h2 { font-size: var(--fs-h3); }
  .contact-side p { color: var(--text-muted); }
  .contact-side ul { display: grid; gap: var(--s-1); margin: var(--s-2) 0 0; padding: 0; list-style: none; color: var(--text-muted); }
  .contact-side li::before { content: '✓'; margin-right: 10px; color: var(--label); font-weight: 700; }
  @media (max-width: 860px) {
    .contact-grid { grid-template-columns: 1fr; }
    .contact-side { position: static; }
  }
</style>
