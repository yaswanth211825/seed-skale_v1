---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { site, whatsappLink } from '../data/site';
---

<BaseLayout
  title="Get a free demo | SkaleSeed"
  description="Tell SkaleSeed about your business and get a free sample page with your name on it. No cost, no pressure."
>
  <PageIntro
    label="Free demo"
    title="See your website before you pay."
    lede="Tell us about your business. We reply on WhatsApp with the next step and a sample page for you to look at."
  />

  <section class="section">
    <div class="container contact-grid">
      <form class="form" action={site.formEndpoint} method="POST" data-contact>
        <input type="hidden" name="project_reference" value="" data-ref />
        <div class="field">
          <label for="name">Your name</label>
          <input id="name" name="name" required autocomplete="name" placeholder="Your full name" />
        </div>
        <div class="field">
          <label for="business">Business name</label>
          <input id="business" name="business" autocomplete="organization" placeholder="Sample Biryani House" />
        </div>
        <div class="field">
          <label for="phone">WhatsApp number</label>
          <input id="phone" name="phone" type="tel" inputmode="tel" required autocomplete="tel" placeholder="+91 98XXX XXXXX" />
        </div>
        <div class="field">
          <label for="need">What do you need?</label>
          <select id="need" name="need">
            <option>Website</option>
            <option>Web app or SaaS</option>
            <option>Meta ads and SEO</option>
            <option>Instagram content</option>
            <option>Not sure yet</option>
          </select>
        </div>
        <div class="field">
          <label for="message">Tell us about your business</label>
          <textarea id="message" name="message" rows="4" placeholder="What do you do, and what would you like help with?"></textarea>
        </div>
        <button class="btn btn-primary" type="submit">Send my request</button>
      </form>

      <aside class="contact-side">
        <h2>Prefer to talk?</h2>
        <p>Message us on WhatsApp and a real person from the team replies.</p>
        <a class="btn btn-secondary" href={whatsappLink()} target="_blank" rel="noopener">Chat on WhatsApp</a>
        <ul>
          <li>Free sample page, no payment</li>
          <li>Reply on WhatsApp</li>
          <li>Based in {site.location}</li>
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  // Arriving from a case study: prefill the message with that project.
  const project = new URLSearchParams(location.search).get('project')?.replace(/[<>]/g, '').slice(0, 60);
  if (project) {
    const msg = document.querySelector<HTMLTextAreaElement>('#message');
    const ref = document.querySelector<HTMLInputElement>('[data-ref]');
    if (msg && !msg.value) msg.value = `I saw your ${project} project. I have a similar problem: `;
    if (ref) ref.value = project;
  }
</script>

<style>
  .contact-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); gap: var(--s-6); align-items: start; }
  .form { display: grid; gap: var(--s-3); padding: var(--s-4); border-radius: var(--r-card); background: var(--surface); border: 1px solid var(--border); }
  .field { display: grid; gap: var(--s-1); }
  label { font-weight: 500; font-size: .95rem; }
  input, select, textarea {
    width: 100%;
    min-height: 48px;
    padding: 12px 14px;
    border: 1.5px solid var(--border);
    border-radius: var(--r-control);
    background: var(--field);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
    transition: border-color var(--t-fast) var(--ease-out);
  }
  input::placeholder, textarea::placeholder { color: rgb(185 198 214 / 70%); }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--saffron); }
  textarea { resize: vertical; }
  .form .btn { width: 100%; min-height: 52px; }

  .contact-side { display: grid; justify-items: start; gap: var(--s-2); padding-top: var(--s-2); }
  .contact-side h2 { font-size: var(--fs-h3); }
  .contact-side p { color: var(--text-muted); }
  .contact-side ul { display: grid; gap: var(--s-1); margin: var(--s-2) 0 0; padding: 0; list-style: none; color: var(--text-muted); }
  .contact-side li::before { content: '✓'; margin-right: 10px; color: var(--label); font-weight: 700; }

  @media (max-width: 860px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .form { padding: var(--s-3) var(--s-2); }
  }
</style>
