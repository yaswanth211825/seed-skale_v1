---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { site, socials, whatsappLink } from '../data/site';

const live = socials.filter((s) => s.external);
---

<BaseLayout
  title="Coming soon | SkaleSeed"
  description="New SkaleSeed channels are on the way. Leave your email and phone number and we will tell you when they go live."
  noindex
>
  <section class="soon">
    <div class="container soon-grid">
      <div class="soon-copy">
        <p class="label" data-network-label>New channel</p>
        <h1 data-no-split>We'll be there <em>very soon.</em><br />Stay tuned.</h1>
        <p class="lede" data-network-text>
          This SkaleSeed channel is still being set up. Leave your details and we will tell you the moment it goes live.
        </p>

        <form class="form-card" action={site.formEndpoint} method="POST" data-form data-success="soon-success" novalidate>
          <input type="hidden" name="_subject" value="Coming soon signup" />
          <input type="hidden" name="channel" value="" data-channel />
          <div class="f-trap" aria-hidden="true"><label>Leave empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label></div>
          <div class="f-row">
            <div class="f-field">
              <label class="f-label" for="cs-email">Email address</label>
              <input class="f-input" id="cs-email" name="email" type="email" inputmode="email" data-rule="email" required autocomplete="email" maxlength="254" placeholder="you@example.com" />
              <small class="f-error" id="cs-email-error"></small>
            </div>
            <div class="f-field">
              <label class="f-label" for="cs-phone">Phone number</label>
              <input class="f-input" id="cs-phone" name="phone" type="tel" inputmode="tel" data-rule="phone" required autocomplete="tel" maxlength="20" placeholder="+91 98765 43210" />
              <small class="f-error" id="cs-phone-error"></small>
            </div>
          </div>
          <button class="btn btn-primary" type="submit">Notify me <span class="arrow" aria-hidden="true">→</span></button>
          <p class="f-status" data-status role="status" aria-live="polite"></p>
        </form>

        <div class="f-success" id="soon-success" tabindex="-1" hidden>
          <span class="f-tick" aria-hidden="true">✓</span>
          <h2>You're on the list.</h2>
          <p>We'll message you as soon as it's live. Meanwhile, take a look at what we build.</p>
          <a class="btn btn-primary" href="/work">See our work <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="soon-visual" aria-hidden="true">
        <div class="badge-card">
          <span class="ring r1"></span><span class="ring r2"></span>
          <span class="badge-icon" data-network-icon>
            <SocialIcon id="youtube" size={56} />
          </span>
          <p class="badge-name" data-network-name>Coming soon</p>
          <div class="progress"><span></span></div>
          <p class="badge-note">Getting ready</p>
        </div>
        {(['linkedin', 'youtube', 'x', 'facebook'] as const).map((id) => (
          <template data-icon={id}><SocialIcon id={id} size={56} /></template>
        ))}
        <span class="sticker s1">✦ Launching soon</span>
        <span class="sticker s2">Made in Hyderabad</span>
      </div>
    </div>
  </section>

  <section class="meanwhile">
    <div class="container meanwhile-inner">
      <p class="label">Meanwhile, find us here</p>
      <ul class="live">
        {live.map((s) => (
          <li>
            <a href={s.href} {...(s.id !== 'email' ? { target: '_blank', rel: 'noopener' } : {})}>
              <SocialIcon id={s.id} />{s.label}
            </a>
          </li>
        ))}
      </ul>
      <nav class="explore" aria-label="Explore SkaleSeed">
        <a href="/">Home</a><a href="/work">Our work</a><a href="/services">Services</a><a href="/blog">Blog</a><a href={whatsappLink()} target="_blank" rel="noopener">WhatsApp us</a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .soon { padding-block: clamp(32px, 6vw, 88px) var(--s-6); }
  .soon-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: var(--s-6); align-items: center; }
  .soon-copy { display: grid; gap: var(--s-3); justify-items: start; }
  h1 { font-size: var(--fs-h1); line-height: 1.05; animation: rise var(--dur-2) var(--ease) both; }
  .lede { max-width: 46ch; color: var(--text-muted); font-size: 1.125rem; }
  .soon-copy .form-card, .soon-copy .f-success { width: 100%; }

  .soon-visual { position: relative; display: grid; place-items: center; min-height: 420px; }
  .badge-card {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--s-2);
    width: min(100%, 340px);
    padding: var(--s-6) var(--s-4) var(--s-4);
    border: 1px solid var(--border);
    border-radius: 32px;
    background: var(--paper);
    box-shadow: 0 30px 70px rgb(11 31 58 / 14%);
    overflow: hidden;
  }
  .ring { position: absolute; top: 46px; left: 50%; translate: -50% 0; border: 1.5px dashed rgb(176 111 0 / 35%); border-radius: 50%; animation: spin 18s linear infinite; }
  .r1 { width: 150px; height: 150px; top: 18px; }
  .r2 { width: 200px; height: 200px; top: -7px; animation-direction: reverse; animation-duration: 26s; }
  .badge-icon { position: relative; z-index: 1; display: grid; place-items: center; width: 104px; height: 104px; border-radius: 30px; background: var(--navy); color: var(--saffron); box-shadow: 0 16px 30px rgb(11 31 58 / 25%); }
  .badge-name { margin-top: var(--s-2); font: 800 1.5rem/1.2 var(--font-display); letter-spacing: -.02em; text-align: center; }
  .progress { width: 100%; height: 10px; overflow: hidden; border-radius: 999px; background: var(--cream-2); }
  .progress span { display: block; width: 72%; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--saffron), var(--coral)); transform-origin: left; animation: fill 2.4s var(--ease) both; }
  .badge-note { color: var(--text-muted); font-size: .9rem; }
  .sticker { position: absolute; padding: 8px 14px; border-radius: 999px; font: 700 .85rem var(--font-display); box-shadow: 0 12px 26px rgb(11 31 58 / 14%); }
  .s1 { top: 10%; right: 4%; background: var(--saffron); color: var(--navy); rotate: 6deg; }
  .s2 { bottom: 12%; left: 2%; background: var(--navy); color: #fff; rotate: -5deg; }

  .meanwhile { padding-block: var(--s-6) var(--section-y); }
  .meanwhile-inner { display: grid; justify-items: center; gap: var(--s-3); padding-top: var(--s-6); border-top: 1px dashed var(--border); text-align: center; }
  .live { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-1); margin: 0; padding: 0; list-style: none; }
  .live a { display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 18px; border: 1px solid var(--border); border-radius: 999px; background: var(--paper); color: var(--text); font-weight: 600; text-decoration: none; transition: border-color var(--dur-1) var(--ease); }
  .live a:hover { border-color: var(--border-strong); }
  .explore { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px var(--s-3); }
  .explore a { display: inline-flex; align-items: center; min-height: 44px; color: var(--text); font-weight: 700; text-decoration: underline; text-decoration-color: var(--saffron); text-decoration-thickness: 2px; text-underline-offset: 6px; }

  @keyframes rise { from { opacity: 0; transform: translateY(var(--rise)); } }
  @keyframes spin { to { rotate: 360deg; } }
  @keyframes fill { from { transform: scaleX(0); } }

  @media (max-width: 900px) {
    .soon-grid { grid-template-columns: 1fr; }
    .soon-visual { order: -1; min-height: 0; padding-block: 22px; }
    .badge-card { width: min(100%, 300px); padding: var(--s-4) var(--s-3) var(--s-3); }
    .s1 { top: 0; right: max(0px, calc(50% - 170px)); }
    .s2 { bottom: 0; left: max(0px, calc(50% - 170px)); }
  }
  @media (prefers-reduced-motion: reduce) {
    h1, .ring, .progress span { animation: none; }
  }
</style>

<script>
  import '../scripts/forms.ts';
  const names: Record<string, string> = { linkedin: 'LinkedIn', youtube: 'YouTube', x: 'X', facebook: 'Facebook' };
  const key = new URLSearchParams(location.search).get('on') ?? '';
  const network = names[key];
  if (network) {
    document.querySelector('[data-network-label]')!.textContent = `SkaleSeed on ${network}`;
    document.querySelector('[data-network-name]')!.textContent = `SkaleSeed on ${network}`;
    document.querySelector('[data-network-text]')!.textContent =
      `Our ${network} page is still being set up. Leave your details and we will tell you the moment it goes live.`;
    (document.querySelector('[data-channel]') as HTMLInputElement).value = network;
    const tpl = document.querySelector<HTMLTemplateElement>(`template[data-icon="${key}"]`);
    const slot = document.querySelector('[data-network-icon]');
    if (tpl && slot) slot.replaceChildren(tpl.content.cloneNode(true));
  }
</script>
