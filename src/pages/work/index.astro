---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import CtaBand from '../../components/CtaBand.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import PageScene from '../../components/PageScene.astro';
import { projects } from '../../data/projects';
---

<BaseLayout
  title="Work | SkaleSeed"
  description="Case studies from SkaleSeed and Amiron Technology: SaaS platforms, AI agents, automation and websites, with the problem, the build and the result."
>
  <PageIntro
    label="Work"
    title="Real projects."
    accent="Real problems solved."
    lede="Platforms, AI tools and websites we have designed and built, with the story behind each one."
    ticker={projects.map((p) => p.name)}
  >
    <a class="btn btn-secondary" href="#projects">Browse the work <span aria-hidden="true">↓</span></a>
    <PageScene kind="work" slot="scene" />
  </PageIntro>

  <section class="section" id="projects">
    <div class="container">
      <h2 class="sr-only">All projects</h2>
      <WorkGrid />
    </div>
  </section>

  <CtaBand title="Have a project in mind?" text="Tell us what you want to build. We reply with a plan and a timeline." />
</BaseLayout>
