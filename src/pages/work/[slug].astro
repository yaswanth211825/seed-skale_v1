---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import { projects } from '../../data/projects';
import { site, whatsappLink } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project: p, next } = Astro.props;
const url = `${site.url}/work/${p.slug}`;
const contactHref = `/contact?project=${encodeURIComponent(p.name)}`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: `${p.name}: ${p.summary}`,
    headline: p.hook,
    description: p.summary,
    url,
    creator: { '@id': `${site.url}/#org` },
    about: p.sector,
    keywords: [p.category, ...p.stack].join(', '),
    ...(p.liveUrl ? { sameAs: p.liveUrl } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Work', item: `${site.url}/work` },
      { '@type': 'ListItem', position: 3, name: p.name, item: url },
    ],
  },
];
---

<BaseLayout title={`${p.name} case study | SkaleSeed`} description={`${p.hook} ${p.summary}`} schema={schema} type="article">
  <!-- Hero -->
  <section class="case-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/work">← All work</a>
      </nav>
      <p class="label">{p.sector}</p>
      <h1><span class="name">{p.name}</span>{p.hook}</h1>
      <p class="lede">{p.summary}</p>
      <div class="actions">
        {p.liveUrl && (
          <a class="btn btn-primary" href={p.liveUrl} target="_blank" rel="noopener">
            Visit {new URL(p.liveUrl).host.replace(/^www\./, '')} <span aria-hidden="true">↗</span>
          </a>
        )}
        <a class:list={['btn', p.liveUrl ? 'btn-secondary' : 'btn-primary']} href={contactHref}>
          Solve a similar problem <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
      {p.statusNote && <p class="status">{p.statusNote}</p>}
    </div>
  </section>

  <!-- Showcase -->
  <section class="showcase">
    <div class="container">
      <div class="showcase-frame" data-reveal="zoom">
        <ProjectMedia project={p} eager sizes="(max-width: 1240px) 100vw, 1200px" />
      </div>
      {p.stats && (
        <dl class="stats" data-stagger>
          {p.stats.map((s) => (
            <div>
              <dd><span data-count={s.value} data-prefix={s.prefix ?? ''} data-suffix={s.suffix}>{s.prefix ?? ''}{s.value}{s.suffix}</span></dd>
              <dt>{s.label}</dt>
            </div>
          ))}
        </dl>
      )}
    </div>
  </section>

  <!-- The problem -->
  <section class="section light" aria-labelledby="problem-title">
    <div class="container two-col">
      <div class="col-head" data-reveal="left">
        <p class="label">The problem</p>
        <h2 id="problem-title">What it felt like before.</h2>
      </div>
      <div class="col-body">
        <div class="story">
          {p.story.map((para) => <p data-reveal="right">{para}</p>)}
        </div>
        <ul class="pains" data-stagger>
          {p.pains.map((pain) => <li>{pain}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- What we built -->
  <section class="section" aria-labelledby="built-title">
    <div class="container two-col">
      <div class="col-head" data-reveal="left">
        <p class="label">What we built</p>
        <h2 id="built-title">The solution.</h2>
      </div>
      <div class="col-body">
        <p class="solution" data-reveal>{p.solution}</p>
        <ul class="features" data-stagger>
          {p.features.map((f, i) => (
            <li><span class="fnum">{String(i + 1).padStart(2, '0')}</span>{f}</li>
          ))}
        </ul>
        <ul class="stack" data-reveal aria-label="Technology used">
          {p.stack.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Results -->
  <section class="section results dark panel" aria-labelledby="results-title">
    <div class="container two-col">
      <div class="col-head" data-reveal="left">
        <p class="label">The result</p>
        <h2 id="results-title">What changed.</h2>
      </div>
      <div class="col-body">
        <p class="outcome" data-reveal>{p.outcome}</p>
        <ul class="result-list" data-stagger>
          {p.results.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Call to action -->
  <section class="similar" aria-labelledby="similar-title">
    <div class="container">
      <div class="similar-card" data-reveal="zoom">
        <div>
          <p class="label dark">Facing something similar?</p>
          <h2 id="similar-title">{p.similar}</h2>
          <p>We solved this for {p.name}. Tell us about your business and we will show you how we would solve it for you, starting with a free demo.</p>
        </div>
        <div class="similar-actions">
          <a class="btn cta-dark" href={contactHref}>Contact us <span class="arrow" aria-hidden="true">→</span></a>
          <a class="text-link" href={whatsappLink(`Hi SkaleSeed, I saw your ${p.name} project and I have a similar problem.`)} target="_blank" rel="noopener">or WhatsApp us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Next project -->
  <nav class="next" aria-label="Next project">
    <div class="container">
      <a href={`/work/${next.slug}`} class="next-link" data-reveal>
        <span class="next-label">Next project</span>
        <span class="next-name">{next.name} <span class="arrow" aria-hidden="true">→</span></span>
        <span class="next-hook">{next.hook}</span>
      </a>
    </div>
  </nav>
</BaseLayout>

<style>
  .case-hero { padding-block: clamp(40px, 6vw, 88px) var(--s-6); }
  .case-hero .container { display: grid; justify-items: start; gap: var(--s-2); }
  .crumbs a { display: inline-flex; align-items: center; min-height: 44px; color: var(--text-muted); text-decoration: none; font-weight: 500; }
  .crumbs a:hover { color: var(--text); }
  h1 { max-width: 20ch; font-size: var(--fs-h1); line-height: 1.1; animation: rise .8s var(--ease-out) both; }
  .name { display: block; margin-bottom: 8px; color: var(--label); font-size: .5em; letter-spacing: 0; }
  .lede { max-width: 58ch; color: var(--text-muted); font-size: 1.125rem; animation: rise .8s .1s var(--ease-out) both; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-1); animation: rise .8s .2s var(--ease-out) both; }
  .status { padding: 8px 14px; border-radius: 999px; background: var(--chip); color: var(--text-muted); font-size: var(--fs-small); }

  .showcase { padding-bottom: var(--section-y); }
  .showcase-frame { overflow: hidden; border: 1px solid var(--border); border-radius: var(--r-panel); box-shadow: var(--shadow-dark); }
  .showcase-frame :global(.media) { aspect-ratio: 16 / 9; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--s-3); margin: var(--s-6) 0 0; }
  .stats div { padding: var(--s-3); border-left: 3px solid var(--saffron); }
  .stats dd { margin: 0; font: 800 clamp(2.25rem, 1.6rem + 2.4vw, 3.5rem)/1 var(--font-display); color: var(--text); font-variant-numeric: tabular-nums; }
  .stats dt { margin-top: 6px; color: var(--text-muted); }

  .two-col { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: var(--s-6); align-items: start; }
  .col-head { display: grid; gap: var(--s-2); position: sticky; top: calc(var(--header-h) + 32px); }
  .col-head h2 { font-size: var(--fs-h2); }
  .col-body { display: grid; gap: var(--s-4); }

  .story { display: grid; gap: var(--s-2); }
  .story p { font-size: 1.125rem; line-height: 1.75; color: #2c3d52; }
  .story p:first-child { font-size: 1.25rem; color: var(--navy); font-weight: 500; }
  .pains { display: grid; gap: var(--s-1); margin: 0; padding: 0; list-style: none; }
  .pains li { display: flex; gap: 12px; padding: var(--s-2) var(--s-3); border-radius: var(--r-control); background: var(--white); border: 1px solid var(--light-border); color: var(--navy); font-weight: 500; }
  .pains li::before { content: ''; flex: none; width: 10px; height: 10px; margin-top: 7px; border-radius: 50%; background: var(--coral); }

  .solution { font-size: 1.125rem; line-height: 1.75; color: var(--text-muted); }
  .features { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-2); margin: 0; padding: 0; list-style: none; }
  .features li { display: grid; gap: 6px; padding: var(--s-3); border: 1px solid var(--border); border-radius: var(--r-card); background: var(--surface); box-shadow: var(--shadow-card); }
  .fnum { color: var(--label); font: 700 var(--fs-small) var(--font-display); }
  .stack { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .stack li { padding: 6px 12px; border-radius: 999px; background: var(--chip); color: var(--text-muted); font-size: .85rem; }

  .results { background: radial-gradient(ellipse at 100% 0%, rgb(255 176 32 / 12%), transparent 50%), var(--navy); }
  .outcome { font: 700 clamp(1.25rem, 1rem + 1vw, 1.75rem)/1.35 var(--font-display); color: var(--text); }
  .result-list { display: grid; gap: var(--s-1); margin: 0; padding: 0; list-style: none; }
  .result-list li { display: flex; gap: 12px; padding: var(--s-2) 0; border-bottom: 1px solid var(--border); color: var(--text-muted); }
  .result-list li::before { content: '✓'; color: var(--saffron); font-weight: 800; }

  .similar { padding-block: var(--section-y); }
  .similar-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding: clamp(32px, 5vw, 64px);
    border-radius: var(--r-panel);
    background: var(--saffron);
    color: var(--navy);
  }
  .similar-card > div:first-child { display: grid; gap: var(--s-2); max-width: 640px; }
  .similar-card h2 { font-size: var(--fs-h2); }
  .similar-card p:not(.label) { color: rgb(11 31 58 / 80%); }
  .label.dark { color: var(--navy); opacity: .75; }
  .similar-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-3); }
  .cta-dark { background: var(--navy); color: #fff; }
  .cta-dark:hover { background: var(--navy-3); }
  .similar-card :focus-visible { outline-color: var(--navy); }
  .text-link { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }

  .next { padding-bottom: var(--section-y); }
  .next-link { display: grid; gap: 6px; padding: var(--s-4) 0; border-top: 1px solid var(--border); color: inherit; text-decoration: none; }
  .next-label { color: var(--text-muted); font-size: var(--fs-small); text-transform: uppercase; letter-spacing: .08em; }
  .next-name { font: 800 var(--fs-h1)/1.1 var(--font-display); }
  .next-name .arrow { display: inline-block; color: var(--accent-ink); transition: transform var(--t-base) var(--ease-out); }
  .next-link:hover .arrow { transform: translateX(8px); }
  .next-hook { color: var(--text-muted); }

  @keyframes rise { from { opacity: 0; transform: translateY(20px); } }

  @media (max-width: 900px) {
    .two-col { grid-template-columns: 1fr; gap: var(--s-3); }
    .col-head { position: static; }
  }
  @media (max-width: 640px) {
    .features { grid-template-columns: 1fr; }
    .actions, .actions .btn, .similar-actions, .cta-dark { width: 100%; }
    .showcase-frame :global(.media) { aspect-ratio: 4 / 3; }
  }
  @media (prefers-reduced-motion: reduce) {
    h1, .lede, .actions { animation: none; }
  }
</style>
